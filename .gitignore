# =============================================================
# ARCHIVOS SENSIBLES — NUNCA SUBIR AL REPOSITORIO
# =============================================================

# Variables de entorno: contienen API keys, credenciales Azure,
# configuración de Claude Foundry y otros secretos.
# Si ves este archivo en un commit, es un error grave.
.env
.env.*
!.env.example

# Script de arranque local: carga variables de entorno sensibles
# (ANTHROPIC_FOUNDRY_API_KEY, configuración Azure, modelos custom).
# Contiene lógica específica del entorno del desarrollador.
start-claude.sh

# =============================================================
# DATOS LOCALES — NO PERTENECEN AL REPOSITORIO
# =============================================================

# Corpus documental histórico: PDFs y metadata de procesos reales.
# Pueden contener información institucional sensible.
data/

# Exports y reportes generados por la app.
exports/

