# =============================================================================
# Configuración de proveedor LLM
# Activa solo UNO de los bloques de abajo (o usa Ollama sin claves).
# Prioridad de detección: Azure → Groq → Ollama → OpenAI directo
# Opcional: seleccionar explícitamente azure, groq, ollama u openai.
# LLM_PROVIDER=openai
# =============================================================================

# --- Opción 1: Azure OpenAI ---
# OPENAI_API_KEY=your_azure_api_key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2024-06-01
# OPENAI_MODEL=gpt-4o-mini

# --- Opción 2: Groq (API compatible con OpenAI) ---
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Opción 3: Ollama local (sin clave externa) ---
# Requiere Ollama corriendo: ollama serve
# Modelos probados: llama3.1, qwen2.5, mistral
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# --- Opción 4: OpenAI directo ---
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Configuración opcional de la aplicación
# =============================================================================

# APP_MAX_DOCUMENT_CHARS=12000
# APP_DEFAULT_CONTEXT_CHARS=260

# Mesa documental local: propuestas semánticas y redacción, con validación de citas
# INTEGRITY_ASSISTED_ENABLED=true
# INTEGRITY_SEMANTIC_ENABLED=true
# Presupuesto compartido: 1 análisis semántico + 1 síntesis por defecto.
# Con 3 solicitudes puede añadirse una explicación. Sin reintentos implícitos.
# INTEGRITY_LLM_MAX_CALLS=2
# INTEGRITY_STORE_PATH=data/workbench/reviews.sqlite3

# Rutas del corpus (relativas al directorio raíz del proyecto)
# APP_CORPUS_METADATA_PATH=data/raw/metadata/procesos.csv
# APP_CORPUS_PLIEGOS_DIR=data/raw/pliegos
# APP_CORPUS_ESPECIFICACIONES_DIR=data/raw/especificaciones
# APP_CORPUS_PROCESSED_DIR=data/processed/extracted_text

# =============================================================================
# Notificaciones por email (interfaz Streamlit)
# Compatible con Gmail con Contraseña de Aplicación y servidores SMTP estándar
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx   # Contraseña de app Gmail, no la normal
# SMTP_FROM=tu_cuenta@gmail.com
