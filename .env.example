# API key del proveedor LLM (obligatorio para usar lectura asistida por IA)
OPENAI_API_KEY=sk-...

# Modelo a usar. Por defecto: gpt-4o-mini
# Otros válidos: gpt-4o, gpt-4.1, gpt-4.1-mini, claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-mini

# URL base del proveedor. Dejar vacío para OpenAI directo.
# Para Azure OpenAI: https://<tu-recurso>.openai.azure.com/
# Para otros proveedores compatibles con la API de OpenAI: URL del endpoint
OPENAI_BASE_URL=
