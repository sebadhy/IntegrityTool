# =============================================================================
# Configuración de proveedor LLM
# Activa solo UNO de los bloques de abajo (o usa Ollama sin claves).
# Prioridad de detección: Azure → Groq → Ollama → OpenAI directo
# Opcional: seleccionar explícitamente azure, groq, ollama u openai.
# LLM_PROVIDER=openai
# =============================================================================

# --- Opción 1: Azure OpenAI ---
# OPENAI_API_KEY=your_azure_api_key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# Definir una version compatible con el deployment y las salidas estructuradas.
# OPENAI_API_VERSION=your_supported_api_version
# OPENAI_MODEL=your_azure_deployment_name

# --- Opción 2: Groq (API compatible con OpenAI) ---
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Opción 3: Ollama local (sin clave externa) ---
# Requiere Ollama corriendo: ollama serve
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# --- Opción 4: OpenAI directo ---
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Configuración opcional de la aplicación
# Para Azure: docs/developer_handoff.md y deploy/azure/*.env.example.
# Los ejemplos no configuran autenticación institucional ni acceso público.
# =============================================================================

# APP_MAX_DOCUMENT_CHARS=12000
# APP_DEFAULT_CONTEXT_CHARS=260

# Mesa documental local: propuestas semánticas y redacción, con validación de citas
# INTEGRITY_ASSISTED_ENABLED=true
# INTEGRITY_SEMANTIC_ENABLED=true
# Presupuesto compartido: 1 análisis semántico + 1 síntesis por defecto.
# Con 3 solicitudes puede añadirse una explicación. Sin reintentos implícitos.
# INTEGRITY_LLM_MAX_CALLS=2
# INTEGRITY_STORE_PATH=data/workbench/reviews.sqlite3

# Persistencia compartida opcional: requiere requirements-azure.txt.
# Inicializar expresamente con: python -m src.manage_storage init
# PostgreSQL remoto exige TLS verificado y una CA configurada.
# INTEGRITY_DATABASE_URL=postgresql://user:password@server:5432/integrity?sslmode=verify-full&sslrootcert=/path/to/ca.pem
# INTEGRITY_DOCUMENT_STORAGE=azure
# INTEGRITY_BLOB_ACCOUNT_URL=https://your-account.blob.core.windows.net/
# INTEGRITY_BLOB_CONTAINER=integrity-documents
# Usa identidad administrada. AZURE_CLIENT_ID solo para identidad asignada por usuario.
# AZURE_CLIENT_ID=your_managed_identity_client_id
# Alternativa por secreto, nunca versionar el valor:
# INTEGRITY_BLOB_CONNECTION_STRING=your_storage_connection_string
# La API registra trabajos; arrancar aparte python -m src.review_worker
# INTEGRITY_WORKER_MODE=external

# Rutas del corpus (relativas al directorio raíz del proyecto)
# APP_CORPUS_METADATA_PATH=data/raw/metadata/procesos.csv
# APP_CORPUS_PLIEGOS_DIR=data/raw/pliegos
# APP_CORPUS_ESPECIFICACIONES_DIR=data/raw/especificaciones
# APP_CORPUS_PROCESSED_DIR=data/processed/extracted_text
