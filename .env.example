# =============================================================
# OPCIÓN A — OpenAI directo
# =============================================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# =============================================================
# OPCIÓN B — Azure OpenAI
# Cuando OPENAI_API_VERSION está presente, el cliente usa AzureOpenAI.
# =============================================================
# OPENAI_API_KEY=<tu Azure API key>
# OPENAI_MODEL=gpt-4o-mini          # nombre del deployment en Azure
# OPENAI_BASE_URL=https://<tu-recurso>.openai.azure.com/
# OPENAI_API_VERSION=2024-06-01

# =============================================================
# CONFIGURACIÓN ACTIVA — completar la opción que uses
# =============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_API_VERSION=

# =============================================================
# RUTAS DEL CORPUS (opcional — valores por defecto indicados)
# =============================================================
# APP_CORPUS_METADATA_PATH=data/raw/metadata/procesos.csv
# APP_CORPUS_PLIEGOS_DIR=data/raw/pliegos
# APP_CORPUS_ESPECIFICACIONES_DIR=data/raw/especificaciones
# APP_CORPUS_PROCESSED_DIR=data/processed/extracted_text

# =============================================================
# COMPORTAMIENTO DE LA APLICACIÓN (opcional — valores por defecto indicados)
# =============================================================
# APP_MAX_DOCUMENT_CHARS=12000        # máx. chars del documento que recibe el LLM
# APP_DEFAULT_CONTEXT_CHARS=260       # ventana de contexto por defecto alrededor de cada señal
# APP_REPORT_TOP_PRIORITIES=3         # señales prioritarias mostradas en la UI y el reporte
# APP_LLM_TOP_FINDINGS=5              # hallazgos enviados al LLM para el brief ejecutivo
# APP_LLM_BALANCE_ROWS=8              # mitigantes/habituales enviados al LLM como contexto de balance
