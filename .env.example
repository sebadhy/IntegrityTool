# On-premise Linux / OCI. Copy to .env; never overwrite existing credentials.
# Guide: docs/onprem_installation.md
INTEGRITY_PUBLIC_ORIGIN=https://integrity.example:8443
INTEGRITY_HTTPS_PORT=8443
# Keep loopback until the certificate, accounts and firewall have been checked.
# To allow the team, set the VM's authorized interface IP (not every interface).
INTEGRITY_BIND_ADDRESS=127.0.0.1
INTEGRITY_SECRETS_DIR=./.secrets
INTEGRITY_IMAGE=integrity-tool:onprem
# Record: git rev-parse HEAD
INTEGRITY_BUILD_REVISION=development

# Optional worker-only Azure OpenAI overlay (no model is used by default).
# docker compose -f compose.yaml -f deploy/onprem/compose.azure-openai.yaml ...
# Save the credential in .secrets/model_key, not here.
# OPENAI_BASE_URL=https://RESOURCE.openai.azure.com/
# OPENAI_API_VERSION=COMPATIBLE_API_VERSION
# OPENAI_MODEL=DEPLOYMENT_NAME
# INTEGRITY_LLM_MAX_CALLS=2

# Local development without containers: python run_workbench.py
# Provider alternatives and corpus settings: docs/configuration.md
# OPENAI_API_KEY_FILE=/absolute/protected/path/model-key
# LLM_PROVIDER=openai
# OPENAI_MODEL=MODEL_NAME
# INTEGRITY_ASSISTED_ENABLED=true
# INTEGRITY_SEMANTIC_ENABLED=true
# INTEGRITY_LLM_MAX_CALLS=2
# APP_CORPUS_METADATA_PATH=data/raw/metadata/procesos.csv
# APP_CORPUS_PLIEGOS_DIR=data/raw/pliegos
# APP_CORPUS_ESPECIFICACIONES_DIR=data/raw/especificaciones

# Container Apps + Entra remains supported independently:
# docs/azure_deployment.md and deploy/azure/*.env.example
