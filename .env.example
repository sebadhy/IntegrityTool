# =============================================================
# OPCIÓN A — OpenAI directo
# =============================================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# =============================================================
# OPCIÓN B — Azure OpenAI
# Cuando OPENAI_API_VERSION está presente, el cliente usa AzureOpenAI.
# =============================================================
# OPENAI_API_KEY=<tu Azure API key>
# OPENAI_MODEL=gpt-4o-mini          # nombre del deployment en Azure
# OPENAI_BASE_URL=https://<tu-recurso>.openai.azure.com/
# OPENAI_API_VERSION=2024-06-01

# =============================================================
# CONFIGURACIÓN ACTIVA — descomentar la opción que uses
# =============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_API_VERSION=
