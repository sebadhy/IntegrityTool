# Same database/container as the API, credentials supplied by the platform.
INTEGRITY_ASSISTED_ENABLED=false
INTEGRITY_DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@SERVER:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
INTEGRITY_DOCUMENT_STORAGE=azure
INTEGRITY_BLOB_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net/
INTEGRITY_BLOB_CONTAINER=integrity-documents
# AZURE_CLIENT_ID=MANAGED_IDENTITY_CLIENT_ID

# Enable only after Azure OpenAI configuration and budget approval:
# INTEGRITY_ASSISTED_ENABLED=true
# INTEGRITY_SEMANTIC_ENABLED=true
# INTEGRITY_LLM_MAX_CALLS=2
# LLM_PROVIDER=azure
# OPENAI_API_KEY=SECRET_FROM_THE_PLATFORM
# OPENAI_BASE_URL=https://RESOURCE.openai.azure.com/
# OPENAI_API_VERSION=COMPATIBLE_API_VERSION
# OPENAI_MODEL=DEPLOYMENT_NAME

# Optional, versioned corpus mounted separately. No PDFs are copied into the image.
# APP_CORPUS_METADATA_PATH=/mnt/corpus/metadata/procesos.csv
# APP_CORPUS_PLIEGOS_DIR=/mnt/corpus/pliegos
# APP_CORPUS_ESPECIFICACIONES_DIR=/mnt/corpus/especificaciones
APP_CORPUS_PROCESSED_DIR=/tmp/integrity/extracted_text
