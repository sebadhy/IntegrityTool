# API configuration contract. Replace placeholders with environment values.
# Institutional access requirements: docs/azure_deployment.md.
INTEGRITY_WORKER_MODE=external
INTEGRITY_ASSISTED_ENABLED=false
# Model credentials belong only to the worker. The API enqueues analysis jobs.
INTEGRITY_DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@SERVER:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
INTEGRITY_DOCUMENT_STORAGE=azure
INTEGRITY_BLOB_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net/
INTEGRITY_BLOB_CONTAINER=integrity-documents
# Only for a user-assigned managed identity attached by the deployer:
# AZURE_CLIENT_ID=MANAGED_IDENTITY_CLIENT_ID
